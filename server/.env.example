PORT=4000

# Origem permitida pelo CORS (o frontend rodando localmente por padrão)
CORS_ORIGIN=http://localhost:5173

# Autenticação da API — deixe as 3 em branco para rodar em modo aberto (sem login), útil em dev.
# Gere ADMIN_PASSWORD_HASH com: npm run hash-password -- <sua-senha>
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Token opcional pra proteger o endpoint de ingestão dos Gateways (POST /api/telemetry).
# Se definido, os Gateways precisam enviar "Authorization: Bearer <token>".
GATEWAY_INGEST_TOKEN=
